# 复制成 .env 再改。.env 不会进 git。本机双击 start.cmd 用的就是这个文件。
# （放到公网服务器上用的是 deploy/.env，见 docs/部署.md）

# 内置助手直接调 Claude API（不填就用这台电脑上登录好的 Claude Code）
# ANTHROPIC_API_KEY=

# 1 = 模拟模式（假回答，走通流程用）；0 = 强制真实模式；不写 = 自动判断
# AGENTWORK_FAKE_AI=1

# 让同一个局域网里的队友也能打开（默认只有本机能访问）
# AGENTWORK_HOST=0.0.0.0

# agent 互相 @ 最多接几轮（默认 3）
# AGENTWORK_MAX_HOPS=3

# 下面几项放到公网上才需要 ——
# 大家在浏览器里打开的地址（接入命令、邀请链接都用它）
# AGENTWORK_PUBLIC_URL=https://chat.example.com
# 注册要填的邀请码（留空 = 谁都能注册）
# AGENTWORK_SIGNUP_CODE=
# 前面有反向代理时，信任它传来的真实 IP 和 https 信息（填代理的地址，或 *）
# AGENTWORK_TRUSTED_PROXIES=127.0.0.1
