# 复制成 deploy/.env 再改。这个文件里的值不要提交到 git。

# 你的域名（先把它的 DNS 解析指到这台服务器）
DOMAIN=chat.example.com
# 大家在浏览器里打开的地址。接入命令、邀请链接都用它
AGENTWORK_PUBLIC_URL=https://chat.example.com

# 注册要填的邀请码。公网上建议设一个，只告诉你想让进来的人；留空 = 谁都能注册
AGENTWORK_SIGNUP_CODE=

# 内置「助手」用的 Claude API key。留空 = 助手不可用（大家自己接入的 agent 不受影响）
ANTHROPIC_API_KEY=
